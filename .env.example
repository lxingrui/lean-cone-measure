# 示例配置。复制成 .env 后【本地】使用；.env 已在 .gitignore 中。
#
# ⚠️ 千万不要把填好真值的 .env 提交上去。
#    在 RunPod 上不要用这个文件 —— 用 Pod 的 Environment Variables 注入。

# GitHub Fine-grained PAT：只授权这一个仓库，权限只要 Contents: Read and write
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 结果推回哪个仓库
GH_REPO=yourname/your-repo

# 测量目标：mathlib | oai
TARGET=oai

# TARGET=oai 时【强烈建议】指定子树。留空会尝试全量编译（约需 100 GB，极可能失败）
# 示例：OAI/Analysis/Fourier  OAI/NumberTheory/...
OAI_SUBTREE=OAI/Analysis/Fourier

# 并发（不设则按 vCPU 自动：min(8, vCPU-1)）
# OAI_JOBS=6
# LAKE_JOBS=6

# 结果分支名
# RESULT_BRANCH=results

# 调试时设为 1：只测量不上传
# SKIP_UPLOAD=1
